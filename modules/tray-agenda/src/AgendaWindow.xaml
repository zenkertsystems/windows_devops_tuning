<Window x:Class="TrayAgenda.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayAgenda" Width="360" Height="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf im Windows-10-Stil: große Uhr + Datum -->
        <Grid x:Name="ClockHeader" Margin="22,16,10,6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="BigTime" FontSize="44" FontWeight="Light"
                           FontFamily="Segoe UI Variable Display Light, Segoe UI Light, Segoe UI"/>
                <TextBlock x:Name="BigDate" FontSize="14" Margin="1,0,0,0" Cursor="Hand"
                           Foreground="{DynamicResource AccentBrush}" MouseLeftButtonUp="BigDate_Click" ToolTip="Zu heute springen"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="Neuer Termin in Outlook" Click="BtnNew_Click"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Aktualisieren" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Kopf (kompakt, ohne Monatsansicht) -->
        <Grid x:Name="CompactHeader" Margin="18,14,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="Termine" FontSize="18" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock x:Name="HeaderSub" Foreground="{DynamicResource SubBrush}" FontSize="12" Margin="0,1,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="BtnToday" Style="{StaticResource IconBtn}" Content="&#xE8D1;" ToolTip="Heute" Click="BtnToday_Click"/>
                <Button x:Name="BtnNew" Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="Neuer Termin in Outlook" Click="BtnNew_Click"/>
                <Button x:Name="BtnRefresh" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Aktualisieren" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Grid>

        <!-- Monatsübersicht (optional) -->
        <StackPanel x:Name="MonthPanel" Grid.Row="1" Margin="12,0,12,6"/>

        <!-- Agenda -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly" Focusable="False">
            <StackPanel x:Name="AgendaPanel" Margin="10,0,10,12"/>
        </ScrollViewer>

        <!-- Fuß -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource FooterBrush}">
            <Grid Margin="14,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatBtn}" Content="Outlook" FontSize="12" Click="BtnOutlook_Click" ToolTip="Outlook-Kalender öffnen"/>
                    <Button Style="{StaticResource FlatBtn}" Content="Google" FontSize="12" Click="BtnGoogle_Click" ToolTip="Google Kalender im Browser öffnen"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
